<UserControl x:Class="AtelierMisaka.Views.Pop_Setting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AtelierMisaka.Views"
             xmlns:basens="clr-namespace:AtelierMisaka"
             xmlns:vm="clr-namespace:AtelierMisaka.ViewModels"
             PreviewMouseDown="UserControl_PreviewMouseDown"
             PreviewKeyDown="UserControl_PreviewKeyDown"
             mc:Ignorable="d" d:DesignHeight="900" d:DesignWidth="1280"
             d:DataContext="{d:DesignInstance Type=vm:VM_Main}">
    <UserControl.Resources>
        <Storyboard x:Key="sb_path" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)">
            <DoubleAnimation RepeatBehavior="Forever" From="360" To="0" Duration="0:0:2" Storyboard.TargetName="p1"/>
            <DoubleAnimation RepeatBehavior="Forever" From="0" To="360" Duration="0:0:3" Storyboard.TargetName="p2"/>
            <DoubleAnimation RepeatBehavior="Forever" From="360" To="0" Duration="0:0:4" Storyboard.TargetName="p3"/>
        </Storyboard>
        <Style x:Key="PS_RB_Setting" TargetType="RadioButton">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bg" Margin="4,0" CornerRadius="12" Background="Transparent" BorderBrush="#00000000" BorderThickness="1">
                            <TextBlock x:Name="tb" Text="{TemplateBinding Content}" FontSize="{TemplateBinding FontSize}" FontWeight="SemiBold"
                                       Foreground="#B6BFCC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#2C323B"/>
                                <Setter TargetName="tb" Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#0B84FF"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#6CB8FF"/>
                                <Setter TargetName="tb" Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PS_RB_RunMode" TargetType="RadioButton">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bg" CornerRadius="12" Background="#2D333C" BorderBrush="#4D5664" BorderThickness="1">
                            <TextBlock x:Name="tb" Text="{TemplateBinding Content}" FontSize="{TemplateBinding FontSize}" FontWeight="SemiBold"
                                       Foreground="#D2DAE6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#343B46"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#7D8898"/>
                                <Setter TargetName="tb" Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#0B84FF"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#6CB8FF"/>
                                <Setter TargetName="tb" Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PS_CB_Setting" TargetType="CheckBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Height="{TemplateBinding Height}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="box" Width="18" Height="18" CornerRadius="5" Background="#22262C" BorderBrush="#697282" BorderThickness="1.5" VerticalAlignment="Center"/>
                            <Path x:Name="mark" Data="M2,10 L7,15 L16,4" Width="14" Height="12" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Stroke="#8AD0FF" StrokeThickness="2.4" StrokeEndLineCap="Round" StrokeStartLineCap="Round" Opacity="0"/>
                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="#0B84FF"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="#6CB8FF"/>
                                <Setter TargetName="mark" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PS_BTN_Setting" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#313640"/>
            <Setter Property="BorderBrush" Value="#555D6B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="#88A5C5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PS_BTN_Primary" TargetType="Button" BasedOn="{StaticResource PS_BTN_Setting}">
            <Setter Property="Background" Value="#0B84FF"/>
            <Setter Property="BorderBrush" Value="#6CB8FF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="PS_FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C9D1DD"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="PS_SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#2F343D"/>
            <Setter Property="BorderBrush" Value="#474E5A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="PS_TB_Setting" TargetType="TextBox" BasedOn="{StaticResource TB_Setting}">
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="PS_ComB_Lang" TargetType="ComboBox" BasedOn="{StaticResource ComB_Lang}">
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
    </UserControl.Resources>
    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="860"/>
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0" Background="#660B0E12" BorderThickness="0"
                Command="{x:Static basens:GlobalCommand.BackCommand}" CommandParameter="{x:Static basens:BackType.Pop}"/>

        <Border Grid.Column="1" Background="#3A3F47" BorderBrush="#505764" BorderThickness="1,0,0,0">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="0" Opacity="0.38"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Margin="22,20,22,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Text_SettingTitle}" FontSize="30" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="{DynamicResource Text_SettingDesc}" FontSize="14" Foreground="#B4BBC8" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" Width="34" Height="34" Margin="14,0,0,0"
                            Command="{x:Static basens:GlobalCommand.BackCommand}" CommandParameter="{x:Static basens:BackType.Pop}"
                            Style="{StaticResource PS_BTN_Setting}" Padding="0">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="22,0,22,18">
                        <Border Style="{StaticResource PS_SectionCard}" Background="#262B32">
                            <Grid Height="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton Grid.Column="0" Content="Fanbox" Style="{StaticResource PS_RB_Setting}"
                                             IsChecked="{Binding Site, Converter={StaticResource atbc}, ConverterParameter={x:Static basens:SiteType.Fanbox}}"/>
                                <RadioButton Grid.Column="1" Content="Fantia" Style="{StaticResource PS_RB_Setting}"
                                             IsChecked="{Binding Site, Converter={StaticResource atbc}, ConverterParameter={x:Static basens:SiteType.Fantia}}"/>
                                <RadioButton Grid.Column="2" Content="Patreon" Style="{StaticResource PS_RB_Setting}"
                                             IsChecked="{Binding Site, Converter={StaticResource atbc}, ConverterParameter={x:Static basens:SiteType.Patreon}}"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource PS_SectionCard}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Text_CreatorUrl}" Style="{StaticResource PS_FieldLabel}" Margin="0"/>
                                    <Button Grid.Column="1" Click="Btn_GetList_Click" Style="{StaticResource PS_BTN_Setting}" Content="{DynamicResource Text_UpdateList}" Width="132" Height="34"/>
                                </Grid>
                                <Grid Height="48">
                                    <TextBox Name="popt" Style="{StaticResource PS_TB_Setting}" Tag="{Binding PostUrlTag}" Text="{Binding Artist.PostUrl, UpdateSourceTrigger=PropertyChanged}"/>
                                    <ToggleButton Template="{StaticResource ComboBoxToggleButton}" HorizontalAlignment="Right"
                                                  x:Name="togb" Focusable="false" ClickMode="Press"
                                                  IsChecked="{Binding IsOpen}" MouseEnter="Togb_MouseEnter" MouseLeave="Togb_MouseLeave"
                                                  Width="{Binding Artist.AName, Converter={StaticResource ntwc}}" Height="48"
                                                  Visibility="{Binding ArtistList.Count, Converter={StaticResource itvc}, Mode=OneWay}"/>
                                    <local:PopupEx IsOpen="{Binding IsOpen}" Placement="Bottom" x:Name="popup" Width="{Binding ElementName=popt, Path=ActualWidth}"
                                                   Focusable="False" AllowsTransparency="True" PopupAnimation="Slide" PlacementTarget="{Binding ElementName=popt}" StaysOpen="False">
                                        <Border x:Name="DropDown" Background="Black" BorderBrush="Gray" BorderThickness="1,0,1,1" SnapsToDevicePixels="True" MaxHeight="205">
                                            <Border.Effect>
                                                <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="0" Opacity="0.5"/>
                                            </Border.Effect>
                                            <ListBox HorizontalAlignment="Stretch" VerticalAlignment="Stretch" x:Name="Lst" Focusable="True"
                                                     ItemsSource="{Binding ArtistList}" SelectedItem="{Binding Artist, UpdateSourceTrigger=PropertyChanged}">
                                                <ListBox.Style>
                                                    <Style TargetType="ListBox">
                                                        <Setter Property="ItemContainerStyle" Value="{StaticResource LBI_Artist}"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBox">
                                                                    <Grid Margin="0">
                                                                        <ScrollViewer Style="{StaticResource for_scrollviewer}">
                                                                            <ItemsPresenter/>
                                                                        </ScrollViewer>
                                                                    </Grid>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="ItemTemplate">
                                                            <Setter.Value>
                                                                <DataTemplate>
                                                                    <Grid Height="40">
                                                                        <TextBlock FontSize="22" Foreground="White" Margin="10,0" VerticalAlignment="Center">
                                                                            <Run Text="{Binding AName}"/>
                                                                            <Run Text=" -- "/>
                                                                            <Run Text="{Binding Id}"/>
                                                                        </TextBlock>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.Style>
                                            </ListBox>
                                        </Border>
                                    </local:PopupEx>
                                </Grid>
                                <TextBlock Visibility="{Binding HasSelected, Converter={StaticResource btvc}, ConverterParameter=collapse}" Margin="4,10,0,0"
                                           Foreground="#9AA4B4" FontSize="13">
                                    <Run Text="{Binding Artist.AName}"/>
                                    <Run Text=" -- "/>
                                    <Run Text="{Binding Artist.Id}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PS_SectionCard}">
                            <StackPanel>
                                <TextBlock Text="IDName" Style="{StaticResource PS_FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource PS_TB_Setting}" Tag="{Binding CookieTag}"
                                             Text="{Binding IDName, UpdateSourceTrigger=PropertyChanged}" Height="48"/>
                                    <Button Grid.Column="1" Style="{StaticResource PS_BTN_Setting}" Width="132" Height="42" Margin="12,3,0,3"
                                            Click="Btn_OpenBrowser_Click" Content="{DynamicResource Text_OpBrowser}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PS_SectionCard}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Text_SavePath}" Style="{StaticResource PS_FieldLabel}"/>
                                <TextBox Style="{StaticResource PS_TB_Setting}" Tag="{DynamicResource Text_SavePathTag}"
                                         Text="{Binding SavePath, UpdateSourceTrigger=PropertyChanged}" Height="48"
                                         MouseDoubleClick="TextBox_MouseDoubleClick"/>
                                <CheckBox Style="{StaticResource PS_CB_Setting}" Content="{DynamicResource Text_CheckFile}" IsChecked="{Binding CheckFile}" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PS_SectionCard}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Text_Cost}" Style="{StaticResource PS_FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource PS_TB_Setting}" Tag="0" Text="{Binding Artist.PayLow, UpdateSourceTrigger=PropertyChanged}" Height="48"/>
                                    <TextBlock Grid.Column="1" Text="~" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" Style="{StaticResource PS_TB_Setting}" Tag="∞" Text="{Binding Artist.PayHigh, UpdateSourceTrigger=PropertyChanged}" Height="48"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PS_SectionCard}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Text_Language}" Style="{StaticResource PS_FieldLabel}"/>
                                <ComboBox Style="{StaticResource PS_ComB_Lang}" SelectedIndex="{Binding SelectedLang}" IsEnabled="{Binding CanChangeLang}" Height="48">
                                    <TextBlock Text="{DynamicResource Text_ZH}"/>
                                    <TextBlock Text="{DynamicResource Text_JP}"/>
                                    <TextBlock Text="{DynamicResource Text_EN}"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PS_SectionCard}">
                            <StackPanel>
                                <CheckBox Style="{StaticResource PS_CB_Setting}" Content="{DynamicResource Text_Proxy}" IsChecked="{Binding UseProxy}"/>
                                <TextBox Style="{StaticResource PS_TB_Setting}" Tag="{DynamicResource Text_ProxyTag}" IsEnabled="{Binding UseProxy}"
                                         Text="{Binding Proxy, UpdateSourceTrigger=PropertyChanged}" Height="48" Margin="0,12,0,0"/>
                                <Image Height="28" Width="28" HorizontalAlignment="Right" Margin="0,8,0,0"
                                       Source="/AtelierMisaka;component/Resources/Status_Cancel.png"
                                       Visibility="{Binding IsProxyError, Converter={StaticResource btvc}, ConverterParameter=collapse}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PS_SectionCard}" Visibility="{Binding ShowStandardDateSection, Converter={StaticResource btvc}, ConverterParameter=collapse}">
                            <StackPanel>
                                <CheckBox Style="{StaticResource PS_CB_Setting}" Content="{DynamicResource Text_Date}" IsChecked="{Binding UseDate}"/>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource PS_TB_Setting}" Tag="{DynamicResource Text_DateTag}"
                                             IsEnabled="{Binding UseDate}" Text="{Binding Date_Start, UpdateSourceTrigger=PropertyChanged}" Height="48"/>
                                    <TextBox Grid.Column="2" Style="{StaticResource PS_TB_Setting}" Tag="{DynamicResource Text_DateTag}"
                                             IsEnabled="{Binding CanEditDateEnd}" Text="{Binding Date_End, UpdateSourceTrigger=PropertyChanged}" Height="48"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PS_SectionCard}" Visibility="{Binding ShowFantiaRunModeTabs, Converter={StaticResource btvc}, ConverterParameter=collapse}" Background="#262B32">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Text_RunMode}" Style="{StaticResource PS_FieldLabel}"/>
                                <Border Background="#1D232A" BorderBrush="#39414C" BorderThickness="1" CornerRadius="14" Padding="6">
                                    <Grid Height="44">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <RadioButton Grid.Column="0" Content="{DynamicResource Text_RunModeTime}" Style="{StaticResource PS_RB_RunMode}"
                                                     GroupName="FantiaRunMode"
                                                     IsChecked="{Binding FantiaTimeRangeModeDraft}"/>
                                        <RadioButton Grid.Column="2" Content="{DynamicResource Text_RunModePolling}" Style="{StaticResource PS_RB_RunMode}"
                                                     GroupName="FantiaRunMode"
                                                     IsChecked="{Binding FantiaPollingSubscriptionModeDraft}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PS_SectionCard}" Visibility="{Binding ShowFantiaTimeRangeSection, Converter={StaticResource btvc}, ConverterParameter=collapse}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Text_Date}" Style="{StaticResource PS_FieldLabel}"/>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource PS_TB_Setting}" Tag="{DynamicResource Text_DateTag}"
                                             Text="{Binding Date_Start, UpdateSourceTrigger=PropertyChanged}" Height="48"/>
                                    <TextBox Grid.Column="2" Style="{StaticResource PS_TB_Setting}" Tag="{DynamicResource Text_DateTag}"
                                             Text="{Binding Date_End, UpdateSourceTrigger=PropertyChanged}" Height="48"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PS_SectionCard}" Visibility="{Binding ShowFantiaPollingSection, Converter={StaticResource btvc}, ConverterParameter=collapse}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Text_PollMode}" Style="{StaticResource PS_FieldLabel}"/>
                                <TextBlock Text="{DynamicResource Text_PollHint}" Foreground="#8F98A6" FontSize="14" Margin="0,10,0,0" TextWrapping="Wrap" Width="620"/>
                                <Border Background="#202730" BorderBrush="#344253" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,14,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Text_PollStatus}" Foreground="#AEB7C4" FontSize="14"/>
                                        <TextBlock Grid.Column="1" Text="{Binding FantiaPollingStatusText}" Foreground="White" FontSize="14" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Row="1" Text="{DynamicResource Text_PollNextCheck}" Foreground="#AEB7C4" FontSize="14" Margin="0,8,0,0"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FantiaPollingNextCheckText}" Foreground="White" FontSize="14" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                                        <TextBlock Grid.Row="2" Text="{DynamicResource Text_PollLastCheck}" Foreground="#AEB7C4" FontSize="14" Margin="0,8,0,0"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FantiaPollingLastCheckText}" Foreground="White" FontSize="14" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="2" Background="#343840" BorderBrush="#4A515D" BorderThickness="0,1,0,0" Padding="22,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Foreground="#B4BBC8" FontSize="13" VerticalAlignment="Center">
                            <Run Text="{DynamicResource Text_CurrVer}"/>
                            <Run Text=" "/>
                            <Run Text="{Binding CurrVersion, Mode=OneTime}"/>
                            <Run Text="    "/>
                            <Run Text="{DynamicResource Text_LaVer}"/>
                            <Run Text=" "/>
                            <Hyperlink Command="{x:Static basens:GlobalCommand.CheckVersionCommand}">
                                <Run Text="{Binding LatestVersion}"/>
                            </Hyperlink>
                        </TextBlock>
                        <Button Grid.Column="1" Click="Btn_Star_Click" Style="{StaticResource PS_BTN_Primary}" Content="{DynamicResource Text_StarButton}" Width="110"/>
                        <Button Grid.Column="2" Click="Btn_Back_Click" Style="{StaticResource PS_BTN_Setting}" Content="{DynamicResource Text_ExitButton}" Margin="12,0,0,0" Width="96"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.ColumnSpan="2" Visibility="{Binding ShowLoad, Converter={StaticResource btvc}}">
            <Border Background="Black" Opacity="0.5" BorderThickness="0"/>
            <Path x:Name="p1" Style="{StaticResource Pa_Load}" Data="M15,100 A85,85 0 1 0 100,15" Stroke="Yellow"/>
            <Path x:Name="p2" Style="{StaticResource Pa_Load}" Data="M155,100 A55,55 0 1 0 100,155" Stroke="DeepSkyBlue"/>
            <Path x:Name="p3" Style="{StaticResource Pa_Load}" Data="M75,100 A25,25 0 1 0 100,75" Stroke="Red"/>
            <StackPanel Margin="0,50" VerticalAlignment="Bottom" HorizontalAlignment="Stretch">
                <TextBlock FontSize="15" Foreground="White" HorizontalAlignment="Center">
                    <Run Text="{DynamicResource Text_PostTitle}"/>
                    <Run Text="{Binding PostTitle}"/>
                </TextBlock>
                <TextBlock FontSize="15" Foreground="White" HorizontalAlignment="Center">
                    <Run Text="{DynamicResource Text_PostCount}"/>
                    <Run Text="{Binding PostCount}"/>
                </TextBlock>
            </StackPanel>
        </Grid>

        <Grid Grid.ColumnSpan="2" Visibility="{Binding ShowLogin, Converter={StaticResource btvc}}" Background="#20FFFFFF">
            <ContentControl Content="{Binding PatreonCefBrowser}" Margin="3,0,3,3"/>
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="27" Margin="10"
                    Height="27" ToolTip="{DynamicResource Text_ClosePost}" Cursor="Hand"
                    Command="{x:Static basens:GlobalCommand.CloseBrowserCommand}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
